<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <package android:name="com.android.chrome" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="com.microsoft.emmx" />
        <package android:name="com.opera.browser" />
        <package android:name="com.sec.android.app.sbrowser" />
        <package android:name="com.brave.browser" />
        <package android:name="org.torproject.torbrowser" />
        <package android:name="org.torproject.torbrowser_alpha" />
    </queries>

    <application
        android:name=".CurbMeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CurbMe"
        android:networkSecurityConfig="@xml/network_security_config">


        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.onboarding.PermissionSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.PinSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
             GuardianRedirectActivity: no UI chrome, instant launch.
             BlockedPageActivity: full-screen block page shown to child.
             Both share block_task affinity so they form an isolated back stack.
        -->
        <activity
            android:name=".service.accessibility.GuardianRedirectActivity"
            android:exported="false"
            android:excludeFromRecents="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity="com.curbme.app.block_task"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />

        <activity
            android:name=".ui.block.BlockedPageActivity"
            android:exported="false"
            android:excludeFromRecents="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity="com.curbme.app.block_task"
            android:theme="@style/Theme.CurbMe" />

        <activity
            android:name=".ui.locks.InterstitialActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:theme="@style/Theme.CurbMe" />


        <!-- ════════════════════════════════════════════════════════════════
             SERVICES
             ════════════════════════════════════════════════════════════════ -->

        <!-- ── Accessibility Service ─────────────────────────────────────── -->
        <service
            android:name=".service.accessibility.GuardianAccessibilityService"
            android:exported="true"
            android:process=":guardian"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- ── Watchdog Service (foreground, survives recents swipe) ─────── -->
        <service
            android:name=".service.WatchdogService"
            android:exported="false"
            android:process=":guardian"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="parental_control_guardian" />
        </service>

        <!-- ── Watchdog Job Service (JobScheduler backup) ────────────────── -->
        <service
            android:name=".service.WatchdogJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- ── VPN Service (DNS-based content filter) ────────────────────── -->
        <service
            android:name=".service.vpn.DnsVpnService"
            android:exported="false"
            android:process=":guardian"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService"
                android:value="@string/vpn_service_description" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="dns_filter_for_parental_control" />
        </service>

        <!-- ── VPN Monitor Service (Layer-3 keep-alive companion) ────────── -->
        <service
            android:name=".service.vpn.VpnMonitorService"
            android:exported="false" />

        <!-- ── App Blocking Engine Service ──────────────────────────────── -->
        <service
            android:name=".service.monitor.AppBlockEngineService"
            android:exported="false"
            android:process=":guardian"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="parental_control_guardian" />
        </service>

        <!-- ── Overlay Services ──────────────────────────────────────────── -->
        <service
            android:name=".service.overlay.OverlayService"
            android:exported="false"
            android:process=":guardian"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="overlay_for_parental_control" />
        </service>


        <service
            android:name=".service.overlay.SettingsBlockOverlayService"
            android:exported="false"
            android:process=":guardian"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="settings_page_block_overlay" />
        </service>

        <!-- ── Firebase Cloud Messaging ─────────────────────────────────── -->
        <service
            android:name=".messaging.MonkMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>


        <!-- ════════════════════════════════════════════════════════════════
             RECEIVERS
             ════════════════════════════════════════════════════════════════ -->

        <!-- ── Device Admin (anti-uninstall protection) ──────────────────── -->
        <receiver
            android:name=".receiver.CurbMeDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- ── Boot Receiver ─────────────────────────────────────────────── -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- ── Alarm Restart Receiver ────────────────────────────────────── -->
        <receiver
            android:name=".receiver.AlarmRestartReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.curbme.app.ALARM_RESTART" />
            </intent-filter>
        </receiver>

        <!-- ── Package Change Receiver ───────────────────────────────────── -->
        <receiver
            android:name=".receiver.PackageChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- ── App Update Receiver ───────────────────────────────────────── -->
        <receiver
            android:name=".receiver.AppUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ── Shizuku Provider ─────────────────────────────────────────── -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>